# /etc/systemd/system/mdetector@.service
# The %i in the template becomes the serial device name, e.g. serial0 or ttyUSB0.

[Unit]
Description=Ultrasound motion detector on %i
# Wait until the device node exists before starting.
After=dev-%i.device

[Service]
Type=simple
# Run the service. %i is replaced by the instance name.
ExecStart=/usr/local/bin/mdetector \
    --port /dev/%i \
    --baud 115200 \
    --slave 1 \
    --interval 100 \
    --average 5 \
    --jitter 50 \
    --distance 350 \
    --flag /var/run/motion-%i.flg \
    --unflag /var/run/no-motion-%i.flg \
    --dump /dev/shm/mdetector-%i.txt

# Restart automatically if the process crashes.
Restart=on-failure
RestartSec=2

[Install]
# Start this service during normal boot.
WantedBy=multi-user.target
